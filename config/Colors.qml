pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Io
import "../Services" as Services

// Shell palette.
//
// The hardcoded Tokyo Night palette below (`fallback`) is what every widget
// starts with, and what it falls back to whenever there is no usable
// wallpaper palette. On top of it, a palette generated by matugen from the
// current wallpaper (~/.cache/d77/palette.json, written by
// wallpaper/set-wallpaper.sh) is blended in by `mix`:
//   0.0 = pure Tokyo Night, 1.0 = pure wallpaper palette.
// `mix` is the single slider in the wallpaper picker, persisted to
// ~/.config/d77/theme-mix.
//
// palette.json and theme-mix are shared with quickshell-d77 and fabric-d77,
// so the keys in the JSON match the token names below.
Singleton {
    id: root

    // Paleta Tokyo Night — consistente com os teus outros projetos (fabric-d77 / quickshell-d77)
    readonly property QtObject fallback: QtObject {
        readonly property color bg: "#1a1b26"
        readonly property color bgDark: "#16161e"
        readonly property color bgHighlight: "#292e42"
        readonly property color fg: "#c0caf5"
        readonly property color fgDark: "#a9b1d6"
        readonly property color comment: "#565f89"

        readonly property color blue: "#7aa2f7"
        readonly property color cyan: "#7dcfff"
        readonly property color green: "#9ece6a"
        readonly property color magenta: "#bb9af7"
        readonly property color orange: "#ff9e64"
        readonly property color red: "#f7768e"
        readonly property color yellow: "#e0af68"

        // Extra tones kept distinct from the base palette above, ported 1:1
        // from quickshell-d77's globalState (g) so modules copied from there
        // (osd, launcher, dashboard, lockscreen, ...) stay visually identical
        // without remapping every color reference.
        readonly property color muted: "#444b6a"
        readonly property color cyanAccent: "#0db9d7"
    }

    // ── Wallpaper palette ────────────────────────────────
    readonly property string palettePath: Quickshell.env("HOME") + "/.cache/d77/palette.json"
    readonly property string mixPath: Quickshell.env("HOME") + "/.config/d77/theme-mix"

    // Parsed palette.json ({} when missing or invalid).
    property var wallpaperPalette: ({})
    // Slider value, 0..1. Set directly by the picker while dragging (live
    // preview) and persisted with saveMix() on release.
    property real mix: 0.0

    // A palette generated for a different wallpaper (or for none, after
    // "Clear") is stale: ignore it instead of tinting the shell with colors
    // that no longer match the screen.
    readonly property bool paletteValid: wallpaperPalette.source !== undefined
        && wallpaperPalette.source === Services.WallpaperState.currentPath
    readonly property real effectiveMix: paletteValid ? Math.max(0, Math.min(1, mix)) : 0

    function _lerp(a, b, t) {
        return Qt.rgba(a.r + (b.r - a.r) * t,
                       a.g + (b.g - a.g) * t,
                       a.b + (b.b - a.b) * t,
                       a.a)
    }
    function _pick(key) {
        var base = fallback[key]
        var hex = wallpaperPalette[key]
        if (effectiveMix === 0 || typeof hex !== "string")
            return base
        return _lerp(base, Qt.color(hex), effectiveMix)
    }

    // Same color with a different alpha, for hover/selection tints that
    // must follow the palette (instead of hardcoded Qt.rgba() values).
    function withAlpha(c, a) {
        return Qt.rgba(c.r, c.g, c.b, a)
    }

    // Re-reads palette.json. Called by the picker once set-wallpaper.sh
    // exits, since FileView may not notice a file that didn't exist yet.
    function reloadPalette() {
        paletteFile.reload()
    }

    function saveMix(value) {
        mix = value
        saveMixProc.command = ["sh", "-c",
            "mkdir -p \"$(dirname \"$1\")\" && printf '%s\\n' \"$2\" > \"$1.tmp\" && mv -f \"$1.tmp\" \"$1\"",
            "sh", mixPath, value.toFixed(2)]
        saveMixProc.running = true
    }

    readonly property color bg: _pick("bg")
    readonly property color bgDark: _pick("bgDark")
    readonly property color bgHighlight: _pick("bgHighlight")
    readonly property color fg: _pick("fg")
    readonly property color fgDark: _pick("fgDark")
    readonly property color comment: _pick("comment")

    readonly property color blue: _pick("blue")
    readonly property color cyan: _pick("cyan")
    readonly property color green: _pick("green")
    readonly property color magenta: _pick("magenta")
    readonly property color orange: _pick("orange")
    readonly property color red: _pick("red")
    readonly property color yellow: _pick("yellow")

    readonly property color muted: _pick("muted")
    readonly property color cyanAccent: _pick("cyanAccent")

    readonly property int radius: 12
    readonly property int barHeight: 40
    readonly property int gap: 10
    readonly property string font: "JetBrainsMono Nerd Font"
    readonly property int fsize: 13

    // The wallpaper path flips before set-wallpaper.sh has finished
    // regenerating the palette; re-read anyway so a palette that is
    // already there (e.g. startup) gets picked up.
    Connections {
        target: Services.WallpaperState
        function onCurrentPathChanged() { paletteFile.reload() }
    }

    FileView {
        id: paletteFile
        path: root.palettePath
        watchChanges: true
        printErrors: false

        onLoaded: {
            try {
                var obj = JSON.parse(text())
                root.wallpaperPalette = (obj && typeof obj === "object") ? obj : ({})
            } catch (e) {
                root.wallpaperPalette = ({})
            }
        }
        onLoadFailed: error => root.wallpaperPalette = ({})
        onFileChanged: paletteFile.reload()
    }

    FileView {
        id: mixFile
        path: root.mixPath
        watchChanges: true
        printErrors: false

        onLoaded: {
            var v = parseFloat(text())
            if (!isNaN(v))
                root.mix = Math.max(0, Math.min(1, v))
        }
        onFileChanged: mixFile.reload()
    }

    Process {
        id: saveMixProc
        running: false
    }
}
